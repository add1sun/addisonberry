source "https://rubygems.org"

# Matches the gem set GitHub Pages builds with, so local previews behave the
# same as production. Run `bundle exec jekyll serve` to preview.
gem "github-pages", group: :jekyll_plugins

gem "jekyll-remote-theme"
gem "jekyll-seo-tag"

# Windows / JRuby timezone data
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
end
